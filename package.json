{
  "name": "mkstack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm i --silent && npm run -s icons && vite",
    "build": "npm i --silent && npm run -s icons && vite build -l error && cp dist/index.html dist/404.html && echo 'Project built successfully!'",
    "test": "npm i --silent && npm run -s icons && tsc --noEmit && eslint --cache && vitest run --reporter=dot --silent && vite build -l error && cp dist/index.html dist/404.html && echo 'All tests passed!'",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
