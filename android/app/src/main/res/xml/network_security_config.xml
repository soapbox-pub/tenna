<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext is off everywhere except to the loopback server that serves
    nsites. Chromium resolves *.localhost to loopback itself and treats the
    origin as secure; Android's cleartext policy is the one thing that would
    still refuse the connection, so it is told about the one domain.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">nsite.localhost</domain>
    </domain-config>
</network-security-config>
