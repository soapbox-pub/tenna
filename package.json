  "//overrides": "@nostrify/react and @nostrify/indexeddb each pin an exact @nostrify/nostrify, and they disagree, so without this one of them gets a nested copy of its own. Two copies of NPool and NUser in one bundle is a subtle hazard wherever an object crosses between them — which is exactly what `NUser.fromBunkerLogin(login, pool)` does. Both are pointed at the one version this app depends on instead.",
  "overrides": {
    "@nostrify/react": {
      "@nostrify/nostrify": "$@nostrify/nostrify"
    },
    "@nostrify/indexeddb": {
      "@nostrify/nostrify": "$@nostrify/nostrify"
    }
  }
}
