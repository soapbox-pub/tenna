<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        allowBackup is off because of what this app's private storage is. The
        login is a Keystore-wrapped secret in shared_prefs, which restores to
        another device as ciphertext nobody can open — but beside it sit the
        sites the user has opened, what each has been allowed to do with their
        keys, what it subscribes to on which relays, and a WebView profile per
        site holding everything that site stored. That is a reading history and
        a set of standing grants, and neither belongs in someone's cloud backup
        by default.
    -->
    <application
        android:name=".TennaApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                A link from an app somewhere else asking to be connected to
                this signer. It lands on the wall, which sends it to the
                settings screen that lists connections — and stops there.

                Nothing is accepted by arriving. Any web page can navigate to
                a nostrconnect: link, and accepting one is a standing
                permission to sign as the user, so the screen asks. See
                DeepLinkHandler.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nostrconnect" />
            </intent-filter>

            <!--
                What a pinned nsite may be offered from the share sheet. See
                @xml/shortcuts, whose <share-target> entries send the share on
                to NsiteShareActivity.

                It has to be declared here, on the launcher activity, and
                nowhere else. The system reads android.app.shortcuts only off
                the activities that answer MAIN/LAUNCHER, so the same element
                on the activity the shares actually arrive at is never parsed
                at all — leaving shortcuts that carry a category nothing on the
                device defines, and a share sheet with nothing to match them
                against.
            -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <!--
            An nsite, in a window of its own. See NsiteAppActivity.

            documentLaunchMode keys a task on this component plus the intent's
            data URI, so one URI per site is one task per site and two sites can
            be open at once. The empty taskAffinity keeps those tasks out of
            Tenna's own, which is what stops a site from surfacing the channel
            wall when the user swipes back to it.

            Exported because the launcher — a different app — is what starts a
            pinned one.
        -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".NsiteAppActivity"
            android:label="@string/app_name"
            android:theme="@style/AppTheme.NsiteLaunch"
            android:documentLaunchMode="intoExisting"
            android:autoRemoveFromRecents="false"
            android:taskAffinity=""
            android:excludeFromRecents="false"
            android:exported="true" />

        <!--
            Where the OS share sheet hands Tenna something. See
            NsiteShareActivity: it draws nothing and finishes at once, having
            copied the payload out of the grants it was started with.

            A pinned nsite that declared a `share_target` appears in the sheet
            as itself, through the sharing shortcuts in @xml/shortcuts; picking
            one sends the share here with its id attached. Those entries are
            declared on MainActivity rather than here, for the reason given
            there. Whether the sheet surfaces them at all is Android's ranking
            to decide, so the plain ACTION_SEND filter is here too — picking
            Tenna itself puts the choice of site to the user instead, and
            always works.

            Translucent rather than themed, because there is nothing to see: a
            visible frame would flash between the sheet closing and the site's
            window opening. Deliberately not `noHistory`, which would finish it
            the moment it stopped being visible — it has to outlive the copy it
            is doing, since the URI grants die with it.
        -->
        <activity
            android:name=".NsiteShareActivity"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

        </activity>

        <!--
            Where another application asks Tenna to sign something. See
            SignerActivity.

            singleTop, which NIP-55 asks for by name, and deliberately not
            singleTask: this activity runs inside the calling app's own task.
            That is what lets a result reach a client that used
            startActivityForResult — an activity launched into a task of its
            own cannot return one — and it is what puts the question over the
            app that asked rather than over a window of Tenna's. A client
            sending several requests with FLAG_ACTIVITY_SINGLE_TOP gets them
            delivered to onNewIntent and answered one after another.

            One window, one result: the extras answer the request that opened
            it and the rest ride along in `results`, which is what a client
            that batches knows to read. See SignerActivity.record.

            The scheme filter is browsable because a web page reaches a signer
            by navigating to one, which is the whole of NIP-55's web transport.
        -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".SignerActivity"
            android:label="@string/app_name"
            android:theme="@style/AppTheme.Signer"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nostrsigner" />
            </intent-filter>

        </activity>

        <!--
            Keeps relays open for every nsite that subscribed to something,
            and hands what arrives to the site's service worker. See
            NappPushService. A special-use type because nothing narrower
            describes an indefinitely open WebSocket, and the data-sync type
            is capped at a few hours a day on Android 15 and later.
        -->
        <service
            android:name=".NappPushService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains Nostr relay WebSocket subscriptions so that installed nsites can deliver notifications in real time" />
        </service>

        <receiver
            android:name=".NappBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
            A button pressed under a site's notification, or one swiped away.
            Not exported: the only things that fire it are the PendingIntents
            this app puts on its own notifications. See NappNotificationReceiver.
        -->
        <receiver
            android:name=".NappNotificationReceiver"
            android:exported="false" />

        <!--
            The background half of NIP-55: a request from an app that has
            already been granted what it is asking for, answered without
            anything appearing on screen. See SignerProvider.

            One class serving several authorities, because the method being
            called is the authority — that is how the NIP addresses it, and the
            clients are already written that way.

            Exported with no android:permission, which is deliberate. There is
            no platform permission that means "may ask about a key", and one
            invented here would be one every client had to declare. What guards
            it is that the caller is named by the binder and answered only for
            what that name has been granted.
        -->
        <provider
            android:name=".SignerProvider"
            android:authorities="${applicationId}.GET_PUBLIC_KEY;${applicationId}.SIGN_EVENT;${applicationId}.NIP04_ENCRYPT;${applicationId}.NIP04_DECRYPT;${applicationId}.NIP44_ENCRYPT;${applicationId}.NIP44_DECRYPT;${applicationId}.DECRYPT_ZAP_EVENT"
            android:enabled="true"
            android:exported="true" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!--
        What Tenna is allowed to see of the rest of the device.

        Since Android 11 an app is shown only the packages it declares an
        interest in, and the interest is declared as the intents it would send.
        This one is the signature of a launchable app — the thing every home
        screen resolves — so it matches exactly the apps that already have an
        icon on the launcher, and nothing that doesn't.

        Deliberately not QUERY_ALL_PACKAGES. Everything on the wall is
        launchable by definition, so the narrow filter answers the whole
        question, and the broad permission is a restricted one that would have
        to be justified to Google Play besides.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        What a site's `getUserMedia` reaches, once the site has been allowed it
        and Android has been asked as well. See NsiteChromeClient.

        Neither is required hardware. A device with no camera runs Tenna
        perfectly well — it is a launcher for web apps, and only some of them
        ask — so declaring these `required="false"` keeps it installable rather
        than letting the Play Store filter the app off such a device.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!--
        What a site's `navigator.geolocation` reaches, on the same terms: the
        site has to have been allowed it first, and Android asked after that.

        Both are declared because the system only offers the choice between
        precise and approximate to an app that asked for both, and either
        answer is a yes — a coarse fix is a less exact one, not a refusal. See
        NsiteChromeClient.

        Not required hardware, for the reason the camera isn't.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
