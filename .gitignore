# Vercel
.vercel

# Icons, rasterised from public/logo.svg by `npm run icons`. The SVG is the
# source; these are build output, and the build makes them before it needs them.
/public/favicon.ico
/public/apple-touch-icon.png
/public/icons/
/android/app/src/main/res/mipmap-*/ic_launcher*.png
/android/app/src/main/res/drawable-*/ic_stat_napp.png
/android/app/src/main/res/values/ic_launcher_background.xml
/ios/App/App/Assets.xcassets/AppIcon.appiconset/AppIcon-512@2x.png

# Tenna's IndexedDB for sites, bundled from src/lib/idb by `npm run idb`.
/ios/App/NsiteNotify/NsiteIndexedDB.js
/ios/App/NsiteNotify/NsiteVault.js

# Secrets
.env
.env.*
!.env.example

# Android release signing material. The CI job writes these from secrets and
# removes them again; a stray local copy must never be committable.
/android/key.properties
/android/app/*.jks
/android/app/*.keystore

# The conformance suite as an nsite, from `node scripts/build-wpt-site.mjs`.
/dist-wpt
