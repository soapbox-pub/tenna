<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>

    <!--
        A site's own window, which is not Tenna and should not announce itself
        as Tenna. Flat, in the colour the tuning static comes up on, so the
        wait before the web layer boots is the same darkness the CRT tune-in
        starts from rather than a splash screen for another app.
    -->
    <style name="AppTheme.NsiteLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@color/nsiteWindow</item>
        <item name="android:windowBackground">@color/nsiteWindow</item>
    </style>

    <!--
        The sheet another application's signing request appears in. See
        SignerActivity.

        Every part of this is about the window drawing nothing, so that the app
        that asked stays visible underneath it — which is the point of asking
        there rather than on a screen of Tenna's own. windowIsFloating stays
        false because the sheet is full-width and sits on the bottom edge, and
        backgroundDimEnabled stays off because the sheet draws its own scrim:
        that way the dim fades in with it, as it does everywhere else in the
        app, instead of appearing a frame early with the window.
    -->
    <style name="AppTheme.Signer" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!--
        A dialog a site opened with `alert`, `confirm` or `prompt`. See
        NsiteChromeClient.

        Stated here rather than left to the theme of the activity the dialog is
        built against, which is a splash screen — AppTheme.NsiteLaunch, whose
        whole business is the flat colour a site's window comes up on and which
        says nothing about what a dialog in it should look like.
    -->
    <style name="NsiteDialog" parent="Theme.AppCompat.DayNight.Dialog.Alert" />
</resources>